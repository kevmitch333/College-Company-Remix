# Disable Directory Browsing and Server Signatures
Options -Indexes
ServerSignature Off

# Block access to sensitive source, environment, and configuration files
<FilesMatch "^\.|\.(json|lock|ts|tsx|md|env|yml|yaml|sh|config\.js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Allow public metadata and feed files
<FilesMatch "^(manifest|robots|sitemap|rss)\.">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>

# Hostinger & Apache / LiteSpeed SPA Router Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Caching & Hardened Security Headers for Production Hosting
<IfModule mod_headers.c>
  # 1. Technology stack concealment (Removes X-Powered-By: Express)
  Header unset X-Powered-By

  # 2. Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # 3. Clickjacking mitigation (Allow framing by same origin and preview environment)
  Header always set X-Frame-Options "SAMEORIGIN"

  # 4. HTTP Strict Transport Security (HSTS) with subdomains and preload eligibility
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 5. Referrer leakage prevention
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 6. Disable legacy reflected XSS filter (OWASP standard, superseded by CSP)
  Header always set X-XSS-Protection "0"

  # 7. Sensitive browser hardware permissions lockdown
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # 8. Cross-Origin-Opener-Policy (COOP) allowing necessary OAuth/popup flows
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # 9. Cross-Origin-Resource-Policy (CORP) protecting internal assets
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # 10. Hardened Content-Security-Policy (CSP) with base-uri, default-src, object-src 'none'
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://college.company https://*.run.app; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-ancestors 'self' https://*.google.com https://*.run.app; upgrade-insecure-requests;"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
