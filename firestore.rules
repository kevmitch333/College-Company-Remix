rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny all unmapped collections and wildcard paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Health-check probe endpoint (read-only for 'connection', write strictly prohibited)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // User & Profile Collections (Addresses Findings #1, #2, #4)
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) 
        && isValidString(request.resource.data.displayName, 1, 100)
        && isValidString(request.resource.data.email, 3, 150);
      allow update: if isOwner(userId)
        && (!('id' in request.resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /user/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Channel Messages & General Messages (Addresses Finding #5)
    match /channels/{channelId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.senderId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 5000);
      allow update, delete: if false;
    }

    match /messages/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.senderId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 5000);
      allow update, delete: if isAdmin();
    }

    // Posts & Editorial Articles (Addresses Finding #3)
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /posts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Comments (Addresses Finding #6)
    match /comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.content, 1, 1000);
      allow update, delete: if isAdmin();
    }

    // Commercial Commerce: Products, Orders, Cart (Addresses Findings #7, #8, #9)
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /cart/{cartId} {
      allow read, write: if isOwner(cartId);
    }

    // System Settings, Configuration, & Admin Registry (Addresses Findings #10, #11, #12)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Institutional Compliance Inquiries & Newsletter Subscriptions
    match /compliance_inquiries/{inquiryId} {
      allow read: if isSignedIn() && (
        (resource.data.submitterId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidString(request.resource.data.institution, 1, 200)
        && isValidString(request.resource.data.submitterEmail, 3, 150)
        && isValidString(request.resource.data.subject, 1, 300)
        && (!('inquiryDetails' in request.resource.data) || request.resource.data.inquiryDetails.size() <= 10000);
      allow update, delete: if false;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if isValidString(request.resource.data.email, 3, 150)
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 100);
      allow update, delete: if false;
    }
  }
}
